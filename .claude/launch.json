{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "live",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.live.config.ts",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "start",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "run",
        "start"
      ],
      "port": 3000
    }
  ]
}
