# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# The history recorder's local state (wrangler dev and local D1/R2), and any local secrets file.
/worker/.wrangler/
/worker/.dev.vars
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
# The maintainer's engineering notes and agent prompts live in work/ and are never published.
/HANDOFF.md
/docs/PROMPT-add-flows.md
# Bulk explorer-scan output is research material kept offline in work/offline-scans/ (NOTICE); the reports cite it by name.
/scripts/registry/label-scan.json
/docs/measurements/2026-10-02/compilation-disclosure-audit.tsv
/docs/measurements/2026-09-28/basescan-activity.json
