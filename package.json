{
  "name": "blockchain-flow-map",
  "version": "1.0.0",
  "private": true,
  "description": "A live, evidence-only map of attributed cross-border stablecoin settlement, read from public RPC endpoints in the browser.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:live": "vite --config vite.live.config.ts --port 5173 --strictPort",
    "build:live": "node scripts/verify-all.mjs && vite build --config vite.live.config.ts",
    "verify": "node scripts/verify-all.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ignore-pattern dist-live"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
